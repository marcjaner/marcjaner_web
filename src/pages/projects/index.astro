---
import Layout from "../../layouts/Layout.astro";
import { art } from "../../lib/art";
import { getProjectContent } from "../../lib/content";
import { formatDate } from "../../lib/format";

const { projects, updates } = await getProjectContent();
const latestUpdate = new Map<string, Date>();
for (const update of updates) {
  const id = update.data.project.id;
  if (!latestUpdate.has(id)) latestUpdate.set(id, update.data.date);
}
const dev = import.meta.env.DEV;
---

<Layout title="Projects" description="Small things I've built, mostly for myself.">
  <h1>Projects</h1>
  <p class="muted">Small things, built fast, mostly for myself. Some get used by a hundred people.</p>
  <div>
    {
      projects.map((project) => {
        const { title, description, date, started, status, draft, technologies, liveUrl, githubUrl } =
          project.data;
        const href = `/projects/${project.id}`;
        const latest = latestUpdate.get(project.id);
        const when = date ?? (started ? formatDate(started) : undefined);
        const pic = art("projects", project.id);
        return (
          <article class:list={["entry", { "has-art": pic }]}>
            {pic && (
              <a class="entry-art" href={href} tabindex="-1" aria-hidden="true">
                <picture>
                  <source media="(width <= 600px)" srcset={pic.full} />
                  <img class="dither" src={pic.thumb} alt="" width="400" height="266" loading="lazy" />
                </picture>
              </a>
            )}
            <div>
              <h3>
                <a href={href}>{title}</a>
                {dev && draft && <span class="tag">Draft</span>}
              </h3>
              <p>{description}</p>
              <div class="foot">
                <span class="meta">{status}</span>
                {when && <span class="meta">{when}</span>}
                {latest && <span class="meta">Journal · {formatDate(latest)}</span>}
                <ul class="tags">
                  {technologies.map((tech) => (
                    <li>
                      <span class="tag">{tech}</span>
                    </li>
                  ))}
                </ul>
                {liveUrl && <a class="arrow meta" href={liveUrl}>Live</a>}
                {githubUrl && <a class="arrow meta" href={githubUrl}>Source</a>}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</Layout>
